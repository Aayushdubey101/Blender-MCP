{
  "mcpServers": {
    "blender": {
      "command": "uv",
      "args": [
        "--directory",
        "/path/to/Blender-MCP",
        "run",
        "blender-mcp"
      ],
      "env": {
        "BLENDER_MCP_HOST": "127.0.0.1",
        "BLENDER_MCP_PORT": "9876",

        "BLENDER_MCP_READ_ONLY": "false",

        "BLENDER_MCP_LOG_FORMAT": "text",

        "POLYHAVEN_CACHE_DIR": "",

        "HYPER3D_API_KEY": "",

        "SKETCHFAB_API_KEY": ""
      }
    }
  }
}
